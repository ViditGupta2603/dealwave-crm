# Copy to .env.  For local demo you can skip this file entirely: `docker compose up --build` works with defaults.

# ---- required for production (docker-compose.prod.yml) ----
DOMAIN=crm.example.com
# Use hex-only values so they are safe inside connection URLs:  openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# openssl rand -hex 48   (the API refuses to start in production with a placeholder value)
JWT_SECRET=

# ---- optional ----
# Load two demo workspaces on first start (only if the database has no workspaces). Keep false in production.
SEED_DEMO=false
# Show one-click demo logins on the sign-in page (build-time). Keep false in production.
SHOW_DEMO_LOGINS=false
# Local stack only
WEB_PORT=8080
APP_URL=http://localhost:8080

# Email (invites and automation emails). Without SMTP, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dealwave CRM <no-reply@yourdomain.com>

# ---- Phase 3 (all optional) ----
# AI model for written summaries and email drafts. Without it, the built-in versions are used and nothing leaves your server.
ANTHROPIC_API_KEY=
AI_MODEL=
# Razorpay (UPI, cards, netbanking). Without KEY_ID and KEY_SECRET, plan changes stay instant and free.
# In the Razorpay dashboard, add a webhook to  https://YOUR_DOMAIN/api/webhooks/razorpay  for the payment.captured event,
# and put the same secret you set there below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Encrypts two-step verification secrets in the database. Strongly recommended in production (openssl rand -hex 32).
# Keep it safe and do not change it afterwards, or people would have to set up two-step verification again.
# If empty, the key is derived from JWT_SECRET instead.
TOTP_ENCRYPTION_KEY=

# ---- Phase 4 (all optional) ----
# "Continue with Google". Without both values the Google button is simply hidden.
# Get them free in Google Cloud Console -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID (Web application).
# Add this exact "Authorized redirect URI" there (it is APP_URL + /api/auth/google/callback):
#   local:       http://localhost:8080/api/auth/google/callback
#   production:  https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false (default): people can use the app straight away and see a "confirm your email" banner.
# true: nobody can sign in with a password until they open the link we email them (needs working SMTP above).
REQUIRE_EMAIL_VERIFICATION=false
