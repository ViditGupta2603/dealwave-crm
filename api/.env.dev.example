# Copy this file to api/.env (same folder). It is for running the API on your laptop with `npm run dev`.
# Works with: docker compose -f docker-compose.dev.yml up -d   (Postgres on 5433, Redis on 6380)

NODE_ENV=development
PORT=4000
JWT_SECRET=local-dev-secret-change-me-but-keep-it-32-chars-or-more

# Database (superuser is used only to run migrations; the app itself uses the low-privilege crm_app role)
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5433/dealwave
DATABASE_URL=postgres://crm_app:secret@localhost:5433/dealwave
APP_DB_PASSWORD=secret
REDIS_URL=redis://localhost:6380

# The address you open in the browser. With `npm run dev` in /web this is port 5173.
# Emailed links and the Google redirect are built from this, so keep it exactly what the address bar shows.
APP_URL=http://localhost:5173

# Load the two demo workspaces the first time
SEED_DEMO=true

# ---- optional ----
# Real email (otherwise links are printed in this terminal, look for "link for")
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password
# MAIL_FROM=Dealwave CRM <you@gmail.com>

# Continue with Google. Redirect URI to register in Google Cloud: http://localhost:5173/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# REQUIRE_EMAIL_VERIFICATION=false
