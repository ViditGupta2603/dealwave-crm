{
  "name": "dealwave-api",
  "version": "1.0.0",
  "description": "Dealwave CRM - multi-tenant CRM API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:setup": "node --env-file-if-exists=.env src/migrate.js && node --env-file-if-exists=.env src/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.10",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.13",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
